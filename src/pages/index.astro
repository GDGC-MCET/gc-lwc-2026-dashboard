---
import Layout from '../layouts/Layout.astro';

import appliedRollNos from '../data/rollNumbers.json';

import skillBadges from '../data/skillBadges.json';
---

<Layout>
  <!-- Roll number data for JS -->
  <script is:inline define:vars={{ appliedRollNos }}>
    window.__APPLIED_ROLL_NOS = appliedRollNos;
  </script>

  <!-- Hero Section -->
  <section class="hero" id="hero">
    <div class="container">
      <p class="hero-tagline animate-in">Google Cloud x GDG on Campus</p>
      <h1 class="animate-in animate-delay-1">Learn with Communities 2026</h1>
      <p class="hero-subtitle animate-in animate-delay-2">
        Level up your cloud skills with hands-on labs, earn Google Cloud Skill Badges, 
        and complete all 10 labs with GDG on Campus MCET.
      </p>

      <div class="hero-stats animate-in animate-delay-3">
        <div class="hero-stat">
          <div class="hero-stat-value">10</div>
          <div class="hero-stat-label">Skill Badges</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-value">200</div>
          <div class="hero-stat-label">Cloud Credits</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-value">7</div>
          <div class="hero-stat-label">Days Left to Register</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-value">Free</div>
          <div class="hero-stat-label">Registration</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Search Section -->
  <section class="search-section" id="search">
    <div class="container">
      <div class="search-wrapper animate-in animate-delay-4">
        <div class="search-input-group">
          <div class="search-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.3-4.3"/>
            </svg>
          </div>
          <input 
            type="text" 
            id="rollno-search" 
            placeholder="Enter your Roll Number (e.g., 16072X7XXXXX)" 
            autocomplete="off"
            spellcheck="false"
          />
          <button class="search-btn" id="search-btn">
            Track
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Stages Section -->
  <section class="stages-section" id="stages">
    <div class="container">
      <h2>📋 Your Learning Journey</h2>

      <div class="tab-group">
        <!-- Tab Navigation -->
        <nav class="tab-nav" role="tablist" aria-label="Learning journey stages">
          <button class="tab-btn active" data-tab="1" role="tab" aria-selected="true" aria-controls="tab-panel-1" id="tab-1">
            <span class="tab-btn-number">1</span>
            <span class="tab-btn-label">Application Status</span>
          </button>
          <button class="tab-btn" data-tab="2" role="tab" aria-selected="false" aria-controls="tab-panel-2" id="tab-2">
            <span class="tab-btn-number">2</span>
            <span class="tab-btn-label">Redeem Your Credits</span>
          </button>
          <button class="tab-btn" data-tab="3" role="tab" aria-selected="false" aria-controls="tab-panel-3" id="tab-3">
            <span class="tab-btn-number">3</span>
            <span class="tab-btn-label">Complete the Stages</span>
          </button>
        </nav>

        <!-- Tab Panels -->
        <div class="tab-panels">
          <!-- Panel 1: Application Status -->
          <div class="tab-panel active" id="tab-panel-1" role="tabpanel" aria-labelledby="tab-1">
            <!-- Invite Post -->
            <div class="invite-post">
              <div class="invite-post-header">
                <span class="emoji">☁️</span>
                <h3>Level Up Your Cloud Skills!</h3>
              </div>
              <div class="invite-post-body">
                <p>
                  Ready to explore Google Cloud and build new tech skills? GDG on Campus - MCET brings you an exciting 
                  learning opportunity through the <strong>Learn with Communities</strong> program!
                </p>

                <div class="invite-highlights">
                  <div class="invite-highlight">
                    <span class="icon">☁️</span>
                    <div>
                      <div class="label">Build Skills</div>
                      <div class="sublabel">Practical training in Cloud Computing, Data & AI</div>
                    </div>
                  </div>
                  <div class="invite-highlight">
                    <span class="icon">🧪</span>
                    <div>
                      <div class="label">Hands-on Labs</div>
                      <div class="sublabel">Real-world applications and interactive learning</div>
                    </div>
                  </div>
                  <div class="invite-highlight">
                    <span class="icon">🏆</span>
                    <div>
                      <div class="label">Earn Skill Badges</div>
                      <div class="sublabel">Verifiable Google Cloud credentials</div>
                    </div>
                  </div>
                  <div class="invite-highlight">
                    <span class="icon">🎁</span>
                    <div>
                      <div class="label">Unlock Rewards</div>
                      <div class="sublabel">Exclusive goodies and community milestones</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- How to Register -->
            <div class="how-to-register">
              <h4>📝 How to Register</h4>
              <ol class="register-steps">
                <li>
                  Visit <a href="https://www.skills.google/" target="_blank" rel="noopener noreferrer">skills.google</a> and create your account
                </li>
                <li>
                  Follow the <a href="https://youtu.be/o0nYT08DI64?si=No2w6Su0-PsBz2J-" target="_blank" rel="noopener noreferrer">setup guide video</a> if you need help creating your account
                </li>
                <li>
                  Make your profile <strong>public</strong> and copy your profile link
                </li>
                <li>
                  Register using the QR code provided in the Instagram post or at the campus event
                </li>
              </ol>
            </div>

            <!-- Deadline -->
            <div class="deadline-banner">
              <span class="icon">📅</span>
              <div class="text">
                <strong>Registration Deadline: 29 October 2026</strong>
                <br />
                <span style="color: var(--text-secondary); font-size: 0.85rem;">
                  Don't miss this opportunity to learn, gain practical experience, earn badges, and grow with the Google Cloud community!
                </span>
              </div>
            </div>

            <!-- Referral & Instagram -->
            <div style="display: flex; flex-wrap: wrap; gap: var(--space-md); align-items: center;">
              <div class="referral-code">
                <span class="label">Referral Code:</span>
                <strong>GDGC-MCETH</strong>
              </div>
              <a href="https://www.instagram.com/p/Deq6bQElCqJ/" target="_blank" rel="noopener noreferrer" class="instagram-link">
                📷 View Instagram Post
              </a>
            </div>
          </div>

          <!-- Panel 2: Redeem Your Credits -->
          <div class="tab-panel" id="tab-panel-2" role="tabpanel" aria-labelledby="tab-2">
            <!-- Credit Redemption Guide -->
            <div class="invite-post">
              <div class="invite-post-header">
                <span class="emoji">💳</span>
                <h3>Redeem Your Cloud Credits</h3>
              </div>
              <div class="invite-post-body">
                <p>
                  To begin your journey of completing the labs and collecting the badges, you will have to redeem your <strong>200 credits</strong> first.
                  Credits act as the currency to complete the labs, as these Google Cloud labs are paid.
                </p>
                <p style="margin-top: var(--space-sm); color: var(--text-secondary); font-size: 0.9rem;">
                  Access codes are dispatched directly to your registered email address within 2-3 days of applying.
                </p>
              </div>
            </div>

            <div class="guide-cta" style="margin-top: var(--space-lg);">
              <div class="guide-cta-icon">▶️</div>
              <div class="guide-cta-text">
                <h4>Video Guide: How to Redeem Your Credits</h4>
                <p>
                  Use this walkthrough video to navigate the process of redeeming your credits step-by-step:
                  <br />
                  <a href="https://youtu.be/WVdUW1wJwyI?si=NsEKp-8ENY9ahKAh" target="_blank" rel="noopener noreferrer">
                    Watch Redemption Guide on YouTube →
                  </a>
                </p>
              </div>
            </div>

            <!-- Credit Steps -->
            <div class="how-to-register" style="margin-top: var(--space-lg);">
              <h4>💳 Step-by-Step Credit Redemption</h4>
              <ol class="register-steps">
                <li>
                  Check your inbox for the official enrollment email containing your 200 Cloud Credits access code
                </li>
                <li>
                  Sign in to your account at <a href="https://www.skills.google/" target="_blank" rel="noopener noreferrer">skills.google</a> (ensure it is the same account you registered with)
                </li>
                <li>
                  Follow the <a href="https://youtu.be/WVdUW1wJwyI?si=NsEKp-8ENY9ahKAh" target="_blank" rel="noopener noreferrer">video guide</a> to input and redeem your access code
                </li>
                <li>
                  Verify that your credit balance reflects 200 credits in your Google Skills Boost profile
                </li>
                <li>
                  Once your credits are ready, head over to <strong>Stage 3</strong> to complete the badges
                </li>
              </ol>
            </div>

            <div class="invite-highlights" style="margin-top: var(--space-lg);">
              <div class="invite-highlight">
                <span class="icon">💰</span>
                <div>
                  <div class="label">200 Credits Allocated</div>
                  <div class="sublabel">Covers all lab costs for the 10 skill badges</div>
                </div>
              </div>
              <div class="invite-highlight">
                <span class="icon">📩</span>
                <div>
                  <div class="label">Delivered via Email</div>
                  <div class="sublabel">Access code received within 2-3 days after enrollment</div>
                </div>
              </div>
              <div class="invite-highlight">
                <span class="icon">🔐</span>
                <div>
                  <div class="label">Registered Profile</div>
                  <div class="sublabel">Log into the same Google account submitted during registration</div>
                </div>
              </div>
              <div class="invite-highlight">
                <span class="icon">🚀</span>
                <div>
                  <div class="label">Ready for Stage 3</div>
                  <div class="sublabel">Proceed to complete the challenge labs once redeemed</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Panel 3: Complete the Stages -->
          <div class="tab-panel" id="tab-panel-3" role="tabpanel" aria-labelledby="tab-3">
            <!-- Important Note Banner -->
            <div class="deadline-banner" style="border-color: rgba(234, 67, 53, 0.35); background: rgba(234, 67, 53, 0.08);">
              <span class="icon">🔴</span>
              <div class="text">
                <strong style="color: var(--gc-red);">You only have to complete the final Challenge Labs for each skill badge!</strong>
                <br />
                <span style="color: var(--text-secondary); font-size: 0.85rem;">
                  That is enough and counts as a submission for a single skill badge. Repeat this process for all 10 badges and you are done.
                </span>
              </div>
            </div>

            <!-- Resource CTAs -->
            <div class="resource-ctas-grid">
              <div class="guide-cta">
                <div class="guide-cta-icon">▶️</div>
                <div class="guide-cta-text">
                  <h4>Step-by-Step Lab Playlist</h4>
                  <p>
                    Walkthrough videos on completing each lab:
                    <br />
                    <a href="https://youtube.com/playlist?list=PLNPCsw6Vr8qk&si=hPyt2sJ1jq7jvpU3" target="_blank" rel="noopener noreferrer">
                      Open Playlist on YouTube →
                    </a>
                  </p>
                </div>
              </div>

              <div class="guide-cta">
                <div class="guide-cta-icon">📊</div>
                <div class="guide-cta-text">
                  <h4>Curriculum Spreadsheet</h4>
                  <p>
                    View the official curriculum sheet with all 10 badges:
                    <br />
                    <a href="https://docs.google.com/spreadsheets/d/e/2PACX-1vTVMEFW24yi5IVcBblZFEK5xMdQyeF9pndf-wxE37BKu5hyOghhSkYiCHW6rSLjNJd5U3OI_E_I9vZi/pubhtml?gid=411469390&single=true" target="_blank" rel="noopener noreferrer">
                      Open Curriculum Spreadsheet →
                    </a>
                  </p>
                </div>
              </div>
            </div>

            <!-- How to Complete the Badges -->
            <div class="how-to-register" style="margin-top: var(--space-lg);">
              <h4>🎖️ How to Complete the 10 Badges</h4>
              <ol class="register-steps">
                <li>
                  Confirm your 200 credits are redeemed from <strong>Stage 2</strong>
                </li>
                <li>
                  Open each Skill Badge course from the curriculum below or the <a href="https://docs.google.com/spreadsheets/d/e/2PACX-1vTVMEFW24yi5IVcBblZFEK5xMdQyeF9pndf-wxE37BKu5hyOghhSkYiCHW6rSLjNJd5U3OI_E_I9vZi/pubhtml?gid=411469390&single=true" target="_blank" rel="noopener noreferrer">curriculum spreadsheet</a>
                </li>
                <li>
                  Complete the <strong>final Challenge Lab</strong> for each skill badge
                </li>
                <li>
                  Ensure your Google Skills Boost profile is set to <strong>public</strong> so each badge is verifiable
                </li>
                <li>
                  Repeat for all 10 badges to fulfill the Learn with Communities requirements
                </li>
              </ol>
            </div>

            <div class="invite-highlights" style="margin-top: var(--space-lg);">
              <div class="invite-highlight">
                <span class="icon">🔴</span>
                <div>
                  <div class="label">Challenge Labs Only</div>
                  <div class="sublabel">Only the final challenge lab is required for badge submission</div>
                </div>
              </div>
              <div class="invite-highlight">
                <span class="icon">🔁</span>
                <div>
                  <div class="label">10 Badges Total</div>
                  <div class="sublabel">Complete all 10 skill badges to finish the curriculum</div>
                </div>
              </div>
              <div class="invite-highlight">
                <span class="icon">📋</span>
                <div>
                  <div class="label">Public Profile Required</div>
                  <div class="sublabel">Keep your Google Skills Boost profile public for verification</div>
                </div>
              </div>
              <div class="invite-highlight">
                <span class="icon">⏱️</span>
                <div>
                  <div class="label">Self-Paced Learning</div>
                  <div class="sublabel">Work through the labs and walkthrough videos at your own pace</div>
                </div>
              </div>
            </div>

            <!-- Badge Grid -->
            <h4 style="font-family: var(--font-display); font-weight: 600; margin-top: var(--space-xl); margin-bottom: var(--space-sm); font-size: 1rem;">
              🎖️ Skill Badge Curriculum (10 Badges)
            </h4>
            <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: var(--space-md);">
              Complete each badge by passing the final challenge lab. Your achievements reflect on your public Google Skills Boost profile.
            </p>

            <div class="badges-grid">
              {skillBadges.map((badge) => (
                <div class={`badge-card ${badge.category}`}>
                  <div class="badge-card-top">
                    <span class="badge-number">#{String(badge.id).padStart(2, '0')}</span>
                    <span class={`badge-category ${badge.category}`}>{badge.categoryLabel}</span>
                  </div>
                  <div class="badge-name">{badge.name}</div>
                  <div class="badge-description">{badge.description}</div>
                  <div class="badge-footer">
                    <span class="badge-type">
                      {badge.credits === 0 ? "⚡ Free (0 Credits)" : `🪙 ${badge.credits} Credits`}
                    </span>
                    <a href={badge.url} target="_blank" rel="noopener noreferrer" class="badge-link">
                      Start Lab →
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Arrow Navigation -->
        <div class="tab-arrow-nav">
          <button class="tab-arrow-btn disabled" id="tab-prev" aria-label="Previous stage">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
            Previous
          </button>
          <span class="tab-arrow-indicator" id="tab-indicator">1 / 3</span>
          <button class="tab-arrow-btn" id="tab-next" aria-label="Next stage">
            Next
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Tab group functionality
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');
  const prevBtn = document.getElementById('tab-prev');
  const nextBtn = document.getElementById('tab-next');
  const indicator = document.getElementById('tab-indicator');
  let currentTab = 1;
  const totalTabs = 3;

  function switchTab(tabNum: number) {
    if (tabNum < 1 || tabNum > totalTabs) return;
    currentTab = tabNum;

    // Update tab buttons
    tabBtns.forEach(btn => {
      const isActive = btn.getAttribute('data-tab') === String(tabNum);
      btn.classList.toggle('active', isActive);
      btn.setAttribute('aria-selected', String(isActive));
    });

    // Update panels
    tabPanels.forEach(panel => {
      const panelId = panel.id;
      const isActive = panelId === `tab-panel-${tabNum}`;
      panel.classList.toggle('active', isActive);
    });

    // Update arrow nav
    if (prevBtn) prevBtn.classList.toggle('disabled', tabNum === 1);
    if (nextBtn) nextBtn.classList.toggle('disabled', tabNum === totalTabs);
    if (indicator) indicator.textContent = `${tabNum} / ${totalTabs}`;

    // Scroll tab group into view smoothly
    const tabGroup = document.querySelector('.tab-group');
    if (tabGroup) {
      const rect = tabGroup.getBoundingClientRect();
      if (rect.top < 0) {
        tabGroup.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  }

  // Tab button clicks
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = Number(btn.getAttribute('data-tab'));
      switchTab(tab);
    });
  });

  // Arrow navigation
  prevBtn?.addEventListener('click', () => switchTab(currentTab - 1));
  nextBtn?.addEventListener('click', () => switchTab(currentTab + 1));

  // Keyboard navigation on tab buttons
  document.querySelector('.tab-nav')?.addEventListener('keydown', (e) => {
    const event = e as KeyboardEvent;
    if (event.key === 'ArrowRight') switchTab(currentTab + 1);
    if (event.key === 'ArrowLeft') switchTab(currentTab - 1);
  });

  // Search functionality with roll number lookup
  const searchInput = document.getElementById('rollno-search') as HTMLInputElement;
  const searchBtn = document.getElementById('search-btn') as HTMLButtonElement;
  const appliedList: string[] = (window as any).__APPLIED_ROLL_NOS || [];

  function handleSearch() {
    const rollNo = searchInput?.value.trim().toUpperCase();
    if (!rollNo) {
      searchInput?.focus();
      return;
    }

    const existing = document.querySelector('.search-result-msg');
    if (existing) existing.remove();

    const isApplied = appliedList.includes(rollNo);

    const msg = document.createElement('div');
    msg.className = 'search-result-msg';

    if (isApplied) {
      msg.style.cssText = `
        max-width: 560px;
        margin: 16px auto 0;
        padding: 16px 20px;
        background: rgba(52, 168, 83, 0.08);
        border: 1px solid rgba(52, 168, 83, 0.25);
        border-radius: 12px;
        font-size: 0.9rem;
        color: #8B949E;
        text-align: center;
        animation: fadeInUp 0.3s ease-out;
      `;
      msg.innerHTML = `
        <div style="font-size: 1.3rem; margin-bottom: 8px;">✅</div>
        <strong style="color: #34A853;">You've applied successfully!</strong>
        <p style="margin-top: 8px;">Roll No: <strong style="color: #F0F6FC;">${rollNo}</strong></p>
        <p style="margin-top: 8px;">Check your email for the access code for cloud credits to complete the 10 labs. You will receive it within 2-3 days.</p>
        <p style="margin-top: 8px; font-size: 0.8rem;">Once you get the email, head to <strong>Stage 2</strong> to redeem your credits, then <strong>Stage 3</strong> to complete the badges.</p>
      `;
    } else {
      msg.style.cssText = `
        max-width: 560px;
        margin: 16px auto 0;
        padding: 16px 20px;
        background: rgba(234, 67, 53, 0.08);
        border: 1px solid rgba(234, 67, 53, 0.25);
        border-radius: 12px;
        font-size: 0.9rem;
        color: #8B949E;
        text-align: center;
        animation: fadeInUp 0.3s ease-out;
      `;
      msg.innerHTML = `
        <div style="font-size: 1.3rem; margin-bottom: 8px;">❌</div>
        <strong style="color: #EA4335;">Roll number not found</strong>
        <p style="margin-top: 8px;">Roll No: <strong style="color: #F0F6FC;">${rollNo}</strong> is not in our applied list.</p>
        <p style="margin-top: 8px;">If you haven't applied yet, register using the QR code in the Instagram post or check <strong>Stage 1</strong> for details.</p>
        <p style="margin-top: 8px;">If you've already applied, check back later, this dashboard will update soon.</p>
      `;
    }

    searchInput.closest('.search-wrapper')?.appendChild(msg);
  }

  searchBtn?.addEventListener('click', handleSearch);
  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') handleSearch();
  });

  // Intersection Observer for animations
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-in');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );

  document.querySelectorAll('.badge-card, .milestone-card').forEach(el => {
    observer.observe(el);
  });

  // Countdown timer for deadline
  function updateCountdown() {
    const deadline = new Date('2026-10-29T23:59:59+05:30').getTime();
    const now = new Date().getTime();
    const diff = deadline - now;

    if (diff <= 0) {
      const statValue = document.querySelectorAll('.hero-stat-value');
      if (statValue[2]) statValue[2].textContent = 'Closed';
      return;
    }

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const statValue = document.querySelectorAll('.hero-stat-value');
    if (statValue[2]) statValue[2].textContent = String(days);
  }

  updateCountdown();
  setInterval(updateCountdown, 60000);
</script>
