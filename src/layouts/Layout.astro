---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "GC LWC 2026 Dashboard | GDG on Campus MCET",
  description = "Google Cloud Learn with Communities 2026 - Student Dashboard for GDG on Campus Methodist College of Engineering & Technology, Hyderabad",
  image = "og-image.png"
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://gdgc-mcet.github.io';
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://gdgc-mcet.github.io');
const ogImageUrl = `${siteUrl}${baseUrl}${image}`;

// Structured data for SEO (Schema.org)
const schemaData = {
  "@context": "https://schema.org",
  "@type": "EducationalEvent",
  "name": "Google Cloud Learn with Communities 2026",
  "description": description,
  "url": canonicalURL.toString(),
  "image": ogImageUrl,
  "startDate": "2026-10-22T00:00:00+05:30",
  "endDate": "2026-10-29T23:59:59+05:30",
  "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "organizer": {
    "@type": "Organization",
    "name": "GDG on Campus MCET",
    "url": "https://github.com/GDGC-MCET"
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0D1117" />
    <meta name="keywords" content="Google Cloud, Learn with Communities, GDG on Campus, MCET, Skill Badges, Cloud Computing, AI, Machine Learning, Gemini, Cloud Vision, Speech API" />
    <meta name="author" content="GDG on Campus MCET" />
    <link rel="canonical" href={canonicalURL} />

    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GDG on Campus MCET" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content="Google Cloud Learn with Communities 2026 - GDG on Campus MCET Dashboard Preview" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Google Cloud Learn with Communities 2026 - GDG on Campus MCET Dashboard Preview" />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="alternate icon" type="image/x-icon" href={`${baseUrl}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${baseUrl}favicon.svg`} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <title>{title}</title>
  </head>
  <body>
    <div class="bg-grid"></div>

    <!-- Header -->
    <header class="header">
      <div class="header-inner">
        <div class="header-brand">
          <div class="header-logo">
            <div class="google-dots">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>
          <div class="header-title">
            GDG on Campus - MCET
            <small>Methodist College of Engineering & Technology</small>
          </div>
        </div>
        <span class="header-badge">LWC 2026</span>
      </div>
    </header>

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-grid">
          <!-- Connect With Us -->
          <div class="footer-section">
            <h3>📬 Connect With Us</h3>
            <p>Stay connected and be part of our growing developer community.</p>
            <ul class="footer-links">
              <li>
                <a href="https://www.linkedin.com/company/google-developer-student-club-mcet/" target="_blank" rel="noopener noreferrer" class="footer-link">
                  <span class="link-icon linkedin">in</span>
                  LinkedIn
                </a>
              </li>
              <li>
                <a href="https://www.instagram.com/gdgc_mcet/" target="_blank" rel="noopener noreferrer" class="footer-link">
                  <span class="link-icon instagram">📷</span>
                  Instagram (@gdgc_mcet)
                </a>
              </li>
              <li>
                <a href="https://gdg.community.dev/gdg-on-campus-methodist-college-of-engineering-technology-hyderabad-india/" target="_blank" rel="noopener noreferrer" class="footer-link">
                  <span class="link-icon gdg">G</span>
                  GDG Community Page
                </a>
              </li>
              <li>
                <a href="https://github.com/GDGC-MCET" target="_blank" rel="noopener noreferrer" class="footer-link">
                  <span class="link-icon github">⟨/⟩</span>
                  GDGC-MCET GitHub
                </a>
              </li>
            </ul>
          </div>

          <!-- Resources -->
          <div class="footer-section">
            <h3>🔗 Resources</h3>
            <p>Helpful links and references for your cloud learning journey.</p>
            <ul class="footer-links">
              <li>
                <a href="https://methodist.edu.in/" target="_blank" rel="noopener noreferrer" class="footer-link">
                  <span class="link-icon web">🌐</span>
                  MCET Official Website
                </a>
              </li>
              <li>
                <a href="https://www.skills.google/" target="_blank" rel="noopener noreferrer" class="footer-link">
                  <span class="link-icon gdg">☁️</span>
                  Google Skills Boost
                </a>
              </li>
              
            </ul>
          </div>

        </div>

        <div class="footer-bottom">
          <p>&copy; 2026 GDG on Campus - Methodist College of Engineering & Technology, Hyderabad. Powered by Google Cloud.</p>
          <div class="footer-google-colors">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
